# Streamlit secrets. For local dev, copy to `.streamlit/secrets.toml`.
# For Streamlit Community Cloud, paste these into the app's
# Settings -> Secrets editor (do NOT commit the real file).
#
# `.streamlit/secrets.toml` is gitignored — never commit real keys.

EXA_API_KEY = "your-exa-api-key-here"
ANTHROPIC_API_KEY = "your-anthropic-api-key-here"
