# Local development secrets. Copy to `.env` and fill in real keys.
# `.env` is gitignored — never commit real keys.

EXA_API_KEY=your-exa-api-key-here
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Optional: override the SQLite file location (defaults to ./prospecting.db)
# PROSPECTING_DB_PATH=prospecting.db
